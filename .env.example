# Public Supabase configuration. These values are safe to expose in the browser.
# Local development: use the API URL and publishable/anon key printed by `supabase start`.
# Production: use the project's URL and publishable key from Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only runtime connection for Drizzle. Use Supavisor transaction pooling
# for serverless runtime and keep prepared statements disabled.
DATABASE_URL=

# Local/operator-only connection for Drizzle Kit migrations. Prefer a direct or
# session-pooled connection; do not add this variable to Vercel runtime.
DATABASE_MIGRATION_URL=

# Server-only privileged key. Reserved for a future, explicitly authorized
# account-invitation flow; this app does not currently use it.
SUPABASE_SERVICE_ROLE_KEY=
